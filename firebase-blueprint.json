{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Personal profile information of Yeasin Arafat",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 150 },
        "photoUrl": { "type": "string", "maxLength": 2000 },
        "shortBio": { "type": "string", "maxLength": 500 },
        "fullBio": { "type": "string", "maxLength": 3000 },
        "location": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "availability": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "title", "email"]
    },
    "About": {
      "title": "About",
      "description": "About section details and background",
      "type": "object",
      "properties": {
        "content": { "type": "string", "maxLength": 5000 },
        "subheading": { "type": "string", "maxLength": 300 },
        "cvUrl": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string" }
      },
      "required": ["content"]
    },
    "Statistic": {
      "title": "Statistic",
      "description": "Key milestone or numeric statistic",
      "type": "object",
      "properties": {
        "value": { "type": "string", "maxLength": 30 },
        "label": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" }
      },
      "required": ["value", "label"]
    },
    "Skill": {
      "title": "Skill",
      "description": "Technical skill and proficiency",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "level": { "type": "number" },
        "enabled": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name", "enabled"]
    },
    "Service": {
      "title": "Service",
      "description": "Service offering",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "icon": { "type": "string", "maxLength": 50 },
        "enabled": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["title", "description", "enabled"]
    },
    "Project": {
      "title": "Project",
      "description": "Portfolio project item",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "thumbnail": { "type": "string", "maxLength": 2000 },
        "images": { "type": "array" },
        "technologies": { "type": "array" },
        "category": { "type": "string", "maxLength": 100 },
        "liveUrl": { "type": "string", "maxLength": 2000 },
        "githubUrl": { "type": "string", "maxLength": 2000 },
        "featured": { "type": "boolean" },
        "published": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "description", "published"]
    },
    "Experience": {
      "title": "Experience",
      "description": "Work and freelance experience item",
      "type": "object",
      "properties": {
        "jobTitle": { "type": "string", "maxLength": 150 },
        "company": { "type": "string", "maxLength": 150 },
        "location": { "type": "string", "maxLength": 150 },
        "startDate": { "type": "string", "maxLength": 50 },
        "endDate": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 3000 },
        "companyLogo": { "type": "string", "maxLength": 2000 },
        "order": { "type": "number" }
      },
      "required": ["jobTitle", "company"]
    },
    "Education": {
      "title": "Education",
      "description": "Educational background",
      "type": "object",
      "properties": {
        "degree": { "type": "string", "maxLength": 150 },
        "field": { "type": "string", "maxLength": 150 },
        "institution": { "type": "string", "maxLength": 200 },
        "startYear": { "type": "string", "maxLength": 50 },
        "endYear": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 2000 },
        "order": { "type": "number" }
      },
      "required": ["degree", "field", "institution"]
    },
    "Certification": {
      "title": "Certification",
      "description": "Professional certificate",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "organization": { "type": "string", "maxLength": 200 },
        "issueDate": { "type": "string", "maxLength": 50 },
        "credentialId": { "type": "string", "maxLength": 150 },
