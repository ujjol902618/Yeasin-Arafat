        "imageUrl": { "type": "string", "maxLength": 2000 },
        "order": { "type": "number" }
      },
      "required": ["title", "organization"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client review or recommendation",
      "type": "object",
      "properties": {
        "clientName": { "type": "string", "maxLength": 150 },
        "company": { "type": "string", "maxLength": 150 },
        "photoUrl": { "type": "string", "maxLength": 2000 },
        "testimonial": { "type": "string", "maxLength": 3000 },
        "rating": { "type": "number" },
        "enabled": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["clientName", "testimonial", "enabled"]
    },
    "Client": {
      "title": "Client",
      "description": "Trusted client brand or logo",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "logoUrl": { "type": "string", "maxLength": 2000 },
        "websiteUrl": { "type": "string", "maxLength": 2000 },
        "enabled": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name", "enabled"]
    },
    "Message": {
      "title": "Message",
      "description": "Public contact inquiry sent to portfolio owner",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 5000 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    },
    "MediaItem": {
      "title": "MediaItem",
      "description": "Media library asset metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 255 },
        "url": { "type": "string", "maxLength": 2000 },
        "storagePath": { "type": "string", "maxLength": 500 },
