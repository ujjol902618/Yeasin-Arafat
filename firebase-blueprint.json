        "mimeType": { "type": "string", "maxLength": 100 },
        "uploadedAt": { "type": "string" }
      },
      "required": ["name", "url"]
    },
    "SocialLink": {
      "title": "SocialLink",
      "description": "Social media profile link",
      "type": "object",
      "properties": {
        "platform": { "type": "string", "maxLength": 50 },
        "url": { "type": "string", "maxLength": 2000 },
        "icon": { "type": "string", "maxLength": 50 },
        "enabled": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["platform", "url", "enabled"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Website global configuration and metadata",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "maxLength": 150 },
        "logoUrl": { "type": "string", "maxLength": 2000 },
        "faviconUrl": { "type": "string", "maxLength": 2000 },
        "metaTitle": { "type": "string", "maxLength": 200 },
        "metaDescription": { "type": "string", "maxLength": 500 },
        "footerText": { "type": "string", "maxLength": 1000 },
        "copyright": { "type": "string", "maxLength": 200 },
        "contactEmail": { "type": "string", "maxLength": 100 },
        "contactPhone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 200 }
      },
      "required": ["siteName"]
    }
