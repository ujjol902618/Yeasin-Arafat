  "firestore": {
    "/profile/{docId}": {
      "schema": "Profile",
      "description": "Personal biography and contact metadata"
    },
    "/about/{docId}": {
      "schema": "About",
      "description": "About section narratives and resume links"
    },
    "/statistics/{statId}": {
      "schema": "Statistic",
      "description": "Key milestone numbers"
    },
    "/skills/{skillId}": {
      "schema": "Skill",
      "description": "Technical skillset inventory"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Client services provided"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Showcased portfolio projects"
    },
    "/experiences/{expId}": {
      "schema": "Experience",
      "description": "Career and work history"
    },
    "/education/{eduId}": {
      "schema": "Education",
      "description": "Academic qualifications"
    },
    "/certifications/{certId}": {
      "schema": "Certification",
      "description": "Earned certifications and badges"
    },
    "/testimonials/{testId}": {
      "schema": "Testimonial",
      "description": "Client recommendations"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Trusted client entities"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Inbound contact messages from visitors"
    },
    "/media/{mediaId}": {
      "schema": "MediaItem",
      "description": "Media library assets list"
    },
    "/socialLinks/{linkId}": {
      "schema": "SocialLink",
      "description": "Social media links"
    },
    "/settings/{docId}": {
