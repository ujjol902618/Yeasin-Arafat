rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 5000;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public portfolio collections: Everyone can read; Valid admin operations can write
    match /profile/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /about/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /statistics/{statId} {
      allow read: if true;
      allow write: if isValidId(statId);
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isValidId(skillId);
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isValidId(serviceId);
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isValidId(projectId);
    }

    match /experiences/{expId} {
      allow read: if true;
      allow write: if isValidId(expId);
    }

    match /education/{eduId} {
      allow read: if true;
      allow write: if isValidId(eduId);
    }

    match /certifications/{certId} {
      allow read: if true;
      allow write: if isValidId(certId);
    }

    match /testimonials/{testId} {
      allow read: if true;
      allow write: if isValidId(testId);
    }

    match /clients/{clientId} {
      allow read: if true;
      allow write: if isValidId(clientId);
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isValidId(mediaId);
    }

    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isValidId(linkId);
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // Contact messages:
    // Anyone can submit a valid contact message
    // Admin can read, mark read, or delete
    match /messages/{messageId} {
      allow create: if isValidMessage(request.resource.data);
      allow read, update, delete: if true;
    }
  }
}
